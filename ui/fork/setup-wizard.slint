// Fork: the setup wizard page. One page per step: a header (app name, "Step 2 of 6", a progress bar),
// a title, a wrapped body, a summary card and/or a few real options, and a footer of buttons (Back on
// the left, Skip and the rerun's Close beside it, the primary Next/Finish on the right). Only options
// and buttons can take focus; text never does. What each page says is prepared in
// src/fork/setup_wizard/text.rs and filled in by src/app/setup_wizard_screen.rs.
//
// Focus numbering (shared with the Rust side): the options that can be chosen, then the buttons that
// exist, left to right. Each option carries its own `focus` number; `focus-left`, `focus-middle`,
// `focus-extra` and `focus-right` carry the number of each button (-1 when it is not shown).

import { SemanticColors, Theme, ThemedScrollbar } from "../shared.slint";
import { DialogChrome } from "../dialogs/chrome.slint";

// One focus look on every guided page: the focused item gets a thick ring and a slightly lighter fill; nothing else
// changes size or colour when focus moves. Colour is kept for meaning: the accent marks the primary button and the
// "Recommended" tag, never focus. On a light theme the ring and fill go dark instead of light.
export global FocusLook {
    out property <bool> light: (Theme.list-background.red + Theme.list-background.green + Theme.list-background.blue) > 3 * 150;
    out property <color> ring: FocusLook.light ? Theme.list-text : SemanticColors.selection-border;
    out property <color> fill: FocusLook.light ? Theme.list-background.darker(0.15) : Theme.list-background.brighter(0.5);
    // The accent, dark enough for white text to read at 7 inches (about 5:1 on the default theme).
    out property <color> accent: SemanticColors.info.darker(0.6);
}

// The ring itself, laid over the item it marks.
export component FocusRing inherits Rectangle {
    in property <length> ring-px: 4px;
    background: transparent;
    border-width: root.ring-px;
    border-color: FocusLook.ring;
}

// kind: 0 an action (opens something), 1 a choice (a radio mark, `chosen` says which one is in use)
export struct WizardOption {
    title: string,
    detail: string,
    kind: int,
    chosen: bool,
    // false: shown dimmed and cannot be chosen or focused (the folder in use, a drive that cannot hold ports)
    enabled: bool,
    // drawn as the recommended choice: filled with the accent colour
    recommended: bool,
    // the focus number of this option (-1 when it cannot take focus)
    focus: int,
    // a picture before the title: 0 none, else fork::page::Icon::code
    icon: int,
    // an On/Off switch at the right: 0 none, 1 off, 2 on
    toggle: int,
}

// The pictures of `WizardOption.icon`, drawn as paths in a 100 by 100 box.
component OptionIcon inherits Rectangle {
    in property <int> icon: 0;
    in property <color> ink: Theme.list-text;
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 100;
        stroke: root.ink;
        stroke-width: root.width * 0.065;
        fill: transparent;
        commands:
            root.icon == 1 ? "M 14 14 H 44 V 44 H 14 Z M 56 14 H 86 V 44 H 56 Z M 14 56 H 44 V 86 H 14 Z M 56 56 H 86 V 86 H 56 Z"
            : root.icon == 2 ? "M 8 28 H 92 V 72 H 8 Z M 30 52 L 44 64 L 70 38"
            : root.icon == 3 ? "M 50 10 V 58 M 30 40 L 50 62 L 70 40 M 14 62 V 88 H 86 V 62"
            : root.icon == 4 ? "M 42 32 H 28 A 18 18 0 0 0 28 68 H 42 M 58 32 H 72 A 18 18 0 0 1 72 68 H 58 M 34 50 H 66"
            : root.icon == 5 ? "M 8 22 H 40 L 48 32 H 92 V 82 H 8 Z"
            : root.icon == 6 ? "M 8 16 H 92 V 84 H 8 Z M 40 33 L 68 50 L 40 67 Z"
            : root.icon == 7 ? "M 12 12 H 76 L 88 24 V 88 H 12 Z M 28 12 V 38 H 68 V 12 M 28 88 V 58 H 72 V 88"
            : root.icon == 8 ? "M 32 50 A 18 18 0 1 1 68 50 A 18 18 0 1 1 32 50 Z M 50 10 V 26 M 50 74 V 90 M 10 50 H 26 M 74 50 H 90 M 22 22 L 33 33 M 67 67 L 78 78 M 78 22 L 67 33 M 33 67 L 22 78"
            : root.icon == 9 ? "M 82 40 A 34 34 0 1 0 84 62 M 84 14 V 42 H 56"
            : "";
    }
}

// One port shown big: its cover (an empty image shows the name instead), its name and a few short lines.
export struct WizardCard {
    image: image,
    // the picture is square (a QR code) instead of a portrait cover
    square: bool,
    title: string,
    lines: [string],
}

// A line of the summary box and the mark before it: 0 none, 1 done, 2 to do, 3 waiting, 4 skipped, 5 problem
// (fork::page::Mark::code).
export struct WizardFact {
    text: string,
    mark: int,
}

// The mark itself: a small drawn picture in a coloured disc, so it can never fall back to an empty box the way a
// text character (a check mark, an arrow) can in a font that lacks it.
export component StatusIcon inherits Rectangle {
    in property <int> mark: 0;
    property <color> ink: SemanticColors.text-on-accent;
    width: 20px;
    height: 20px;
    border-radius: self.width / 2;
    background: root.mark == 1 ? SemanticColors.success
        : root.mark == 2 ? SemanticColors.info.darker(0.3)
        : root.mark == 3 ? SemanticColors.warning
        : root.mark == 5 ? SemanticColors.danger
        : Theme.search-text;
    // Done: a check.
    if root.mark == 1: Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 100;
        commands: "M 27 52 L 44 69 L 74 34";
        stroke: root.ink;
        stroke-width: root.width * 0.12;
        fill: transparent;
    }
    // To do: an arrow pointing on.
    if root.mark == 2: Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 100;
        commands: "M 26 50 L 72 50 M 54 32 L 72 50 L 54 68";
        stroke: root.ink;
        stroke-width: root.width * 0.12;
        fill: transparent;
    }
    // Waiting: a clock.
    if root.mark == 3: Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 100;
        commands: "M 50 24 L 50 52 L 68 62";
        stroke: root.ink;
        stroke-width: root.width * 0.12;
        fill: transparent;
    }
    // Skipped: a dash.
    if root.mark == 4: Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 100;
        commands: "M 28 50 L 72 50";
        stroke: root.ink;
        stroke-width: root.width * 0.12;
        fill: transparent;
    }
    // Problem: an exclamation mark.
    if root.mark == 5: Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 100;
        commands: "M 50 24 L 50 56 M 50 70 L 50 76";
        stroke: root.ink;
        stroke-width: root.width * 0.13;
        fill: transparent;
    }
}

// How far the work is: filled up to `value` (0 to 1), or a block sliding along when `busy` (no total known).
component ProgressBar inherits Rectangle {
    in property <bool> busy: false;
    in property <float> value: 0;
    background: Theme.search-background;
    border-width: 1px;
    border-color: Theme.border-color;
    border-radius: self.height / 2;
    clip: true;
    property <float> phase: Math.mod(animation-tick() / 1ms, 1600) / 1600;
    Rectangle {
        x: root.busy ? (root.width * 1.35) * root.phase - root.width * 0.35 : 0px;
        width: root.busy ? root.width * 0.35 : root.width * max(0, min(1, root.value));
        height: 100%;
        border-radius: root.height / 2;
        background: SemanticColors.info;
    }
}

// A cover with its name under it. `focus` is the focus number when the tile can be chosen (-1: shown only).
export struct WizardTile {
    image: image,
    label: string,
    note: string,
    focus: int,
}

component WizardButton inherits Rectangle {
    in property <string> text: "";
    in property <bool> primary: false;
    in property <bool> selected: false;
    in property <length> border-px: 1px;
    in property <length> ring-px: 4px;
    in property <length> font-size: 14px;
    out property <length> text-preferred-width: label.preferred-width;
    callback clicked();
    // The pointer really moved over the button (its position inside it). A pointer that merely rests
    // where a page opened sends none, so it cannot take the highlight from the controller.
    callback moved(length, length);

    background: root.primary ? FocusLook.accent : (root.selected ? FocusLook.fill : Theme.list-background);
    border-width: root.border-px;
    border-color: root.primary ? FocusLook.accent : Theme.border-color;

    TouchArea {
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.move) {
                root.moved(self.mouse-x, self.mouse-y);
            }
        }
    }
    label := Text {
        text: root.text;
        color: root.primary ? SemanticColors.text-on-accent : Theme.list-text;
        font-size: root.font-size;
        font-weight: root.primary ? 700 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
    if root.selected: FocusRing {
        width: 100%;
        height: 100%;
        ring-px: root.ring-px;
    }
}

component OptionRow inherits Rectangle {
    in property <string> title: "";
    in property <string> detail: "";
    in property <int> kind: 0;
    in property <bool> chosen: false;
    in property <bool> enabled: true;
    in property <bool> recommended: false;
    in property <int> icon: 0;
    in property <int> toggle: 0;
    in property <bool> selected: false;
    in property <length> border-px: 1px;
    in property <length> ring-px: 4px;
    in property <length> font-size: 14px;
    callback clicked();
    callback moved(length, length);

    opacity: root.enabled ? 1.0 : 0.5;
    background: root.selected ? FocusLook.fill : Theme.list-background;
    border-width: root.border-px;
    border-color: Theme.border-color;

    TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.move) {
                root.moved(self.mouse-x, self.mouse-y);
            }
        }
    }

    property <length> mark-size: root.font-size * 1.1;
    // A picture before the title (the cards of Settings and Add a port), and an On/Off switch at the right.
    property <length> icon-size: min(root.height * 0.58, root.font-size * 2.2);
    property <length> icon-pad: root.icon > 0 ? root.icon-size + root.font-size * 0.8 : 0px;
    property <length> pill-w: root.font-size * 3.4;
    property <length> pill-h: root.font-size * 1.8;
    property <length> pill-room: root.toggle > 0 ? root.pill-w + root.font-size * 0.7 : 0px;
    property <length> text-x: (root.kind == 1 ? root.font-size * 0.9 + root.mark-size + root.font-size * 0.7 : root.font-size * 0.9) + root.icon-pad;
    property <color> text-color: Theme.list-text;
    // "Recommended": a small tag at the right of the title and an accent edge on the left. Never a fill: a fill
    // looked like focus.
    property <length> tag-font: root.font-size * 0.72;
    property <length> tag-w: root.recommended ? tag-m.preferred-width + root.tag-font * 1.4 : 0px;
    property <length> title-y: root.detail == "" ? 0px : root.height * 0.08;
    property <length> title-h: root.detail == "" ? root.height : root.height * 0.46;
    tag-m := Text {
        visible: false;
        text: "Recommended";
        font-size: root.tag-font;
        font-weight: 700;
    }
    if root.recommended: Rectangle {
        x: 0px;
        y: 0px;
        width: max(3px, root.font-size * 0.28);
        height: root.height;
        background: SemanticColors.info;
    }
    if root.recommended: Rectangle {
        x: root.width - root.tag-w - root.font-size * 0.9;
        y: root.title-y + (root.title-h - self.height) / 2;
        width: root.tag-w;
        height: root.tag-font * 1.75;
        border-radius: self.height / 2;
        background: FocusLook.accent;
        Text {
            text: "Recommended";
            color: SemanticColors.text-on-accent;
            font-size: root.tag-font;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: 100%;
            height: 100%;
        }
    }

    if root.kind == 1: Rectangle {
        x: root.font-size * 0.9;
        y: (root.height - root.mark-size) / 2;
        width: root.mark-size;
        height: root.mark-size;
        border-radius: root.mark-size / 2;
        border-width: 2px / Theme.scale-factor;
        border-color: root.text-color;
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: root.chosen ? parent.width * 0.5 : 0px;
            height: self.width;
            border-radius: self.width / 2;
            background: root.text-color;
        }
    }
    if root.icon > 0: OptionIcon {
        x: root.font-size * 0.9;
        y: (root.height - self.height) / 2;
        width: root.icon-size;
        height: root.icon-size;
        icon: root.icon;
        ink: root.text-color;
    }
    if root.toggle > 0: Rectangle {
        x: root.width - root.pill-w - root.font-size * 0.9;
        y: (root.height - self.height) / 2;
        width: root.pill-w;
        height: root.pill-h;
        border-radius: self.height / 2;
        background: root.toggle == 2 ? FocusLook.accent : transparent;
        border-width: max(1.5px, 2px / Theme.scale-factor);
        border-color: root.toggle == 2 ? FocusLook.accent : Theme.search-text;
        Text {
            text: root.toggle == 2 ? "On" : "Off";
            color: root.toggle == 2 ? SemanticColors.text-on-accent : Theme.list-text;
            font-size: root.font-size * 0.9;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: 100%;
            height: 100%;
        }
    }
    Text {
        x: root.text-x;
        y: root.title-y;
        width: root.width - root.text-x - root.font-size * 0.9 - root.pill-room - (root.recommended ? root.tag-w + root.font-size * 0.6 : 0px);
        height: root.title-h;
        text: root.title;
        color: root.text-color;
        font-size: root.font-size;
        font-weight: root.kind == 1 && root.chosen ? 700 : 400;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.detail != "": Text {
        x: root.text-x;
        y: root.height * 0.52;
        width: root.width - root.text-x - root.font-size * 0.9 - root.pill-room;
        height: root.height * 0.4;
        text: root.detail;
        color: root.text-color;
        opacity: 0.75;
        font-size: root.font-size * 0.85;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.selected: FocusRing {
        width: 100%;
        height: 100%;
        ring-px: root.ring-px;
    }
}

// A cover, or the port's name on a plain tile when there is no picture (yet).
component Cover inherits Rectangle {
    in property <image> source;
    in property <string> label: "";
    in property <length> font-size: 14px;
    in property <length> border-px: 1px;
    in property <length> ring-px: 4px;
    in property <bool> selected: false;

    background: Theme.search-background;
    border-width: root.border-px;
    border-color: Theme.border-color;
    clip: true;

    if root.source.width > 0: Image {
        source: root.source;
        width: 100%;
        height: 100%;
        image-fit: contain;
    }
    if root.source.width == 0: Text {
        x: root.font-size * 0.4;
        width: root.width - root.font-size * 0.8;
        height: root.height;
        text: root.label;
        color: Theme.list-text;
        font-size: root.font-size;
        font-weight: 700;
        wrap: word-wrap;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.selected: FocusRing {
        width: 100%;
        height: 100%;
        ring-px: root.ring-px;
    }
}

// One port big: the cover on the left, the name and a few short lines beside it.
component CardBox inherits Rectangle {
    in property <WizardCard> card;
    in property <length> font-size: 14px;
    in property <length> border-px: 1px;
    property <length> pad: root.font-size * 0.9;

    background: Theme.search-background;
    border-width: root.border-px;
    border-color: Theme.border-color;

    cover := Cover {
        x: root.pad;
        y: root.pad;
        height: root.height - root.pad * 2;
        width: self.height * (root.card.square ? 1.0 : 0.68);
        source: root.card.image;
        label: root.card.title;
        font-size: root.font-size * 0.9;
        border-px: root.border-px;
    }
    VerticalLayout {
        x: cover.x + cover.width + root.pad;
        y: root.pad;
        width: root.width - self.x - root.pad;
        height: root.height - root.pad * 2;
        alignment: start;
        spacing: root.font-size * 0.5;
        Text {
            text: root.card.title;
            color: Theme.list-text;
            font-size: root.font-size * 1.5;
            font-weight: 700;
            wrap: word-wrap;
        }
        for line in root.card.lines: Text {
            text: line;
            color: Theme.list-text;
            font-size: root.font-size;
            wrap: word-wrap;
        }
    }
}

// A cover with the port's name under it.
component TileBox inherits Rectangle {
    in property <WizardTile> tile;
    in property <bool> selected: false;
    in property <length> font-size: 14px;
    in property <length> border-px: 1px;
    in property <length> ring-px: 4px;
    callback clicked();
    callback moved(length, length);
    property <length> label-h: root.font-size * 3.4;

    VerticalLayout {
        spacing: root.font-size * 0.25;
        Cover {
            vertical-stretch: 1;
            source: root.tile.image;
            label: "";
            font-size: root.font-size * 0.85;
            border-px: root.border-px;
            ring-px: root.ring-px;
            selected: root.selected;
        }
        Text {
            height: root.tile.note == "" ? root.font-size * 2.6 : root.font-size * 1.4;
            text: root.tile.label;
            color: Theme.list-text;
            font-size: root.font-size * 0.9;
            wrap: word-wrap;
            overflow: elide;
            horizontal-alignment: center;
            vertical-alignment: top;
        }
        if root.tile.note != "": Text {
            height: root.font-size * 1.2;
            text: root.tile.note;
            color: Theme.list-text;
            opacity: 0.7;
            font-size: root.font-size * 0.75;
            overflow: elide;
            horizontal-alignment: center;
            vertical-alignment: top;
        }
    }
    TouchArea {
        enabled: root.tile.focus >= 0;
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.move) {
                root.moved(self.mouse-x, self.mouse-y);
            }
        }
    }
}

export component SetupWizardDialog inherits Window {
    no-frame: true;
    title: root.dialog-title;
    background: Theme.list-background;
    in property <length> initial-width: 800px;
    in property <length> initial-height: 600px;
    width: initial-width;
    height: initial-height;

    in property <string> font-family;
    default-font-family: root.font-family;

    in property <string> dialog-title: "";
    in property <string> header-text: "";
    in property <string> step-text: "";
    in property <int> step-count: 6;
    in property <int> step-index: 0;
    in property <string> page-title: "";
    in property <[string]> paragraphs: [];
    in property <[WizardFact]> facts: [];
    // A progress bar under the summary box: 0 none, 1 how far (`progress-value`, 0 to 1), 2 a moving bar.
    in property <int> progress-kind: 0;
    // Some line of the summary box has a mark (the unmarked ones keep the same indent).
    in property <bool> facts-marked: false;
    in property <float> progress-value: 0;
    // Fills the screen (big mode, Game Mode): no title bar, no X, wider margins, the step counter beside the title.
    in property <bool> full: false;
    // One port shown big (the Import ports cards), and a row of covers (found ports, ports to move).
    in property <bool> large: false;
    in property <bool> has-card: false;
    in property <WizardCard> card;
    in property <[WizardTile]> tiles: [];
    // A text box in the page: what it shows when empty, what it holds, and its focus number (-1: none). The page
    // owner is told of every edit; Down, Up, A and Return leave the box through move-requested.
    in property <bool> has-input: false;
    in property <string> input-placeholder: "";
    in-out property <string> input-text: "";
    in property <int> input-focus: -1;
    in property <[WizardOption]> options: [];
    in property <string> footnote: "";
    // The controller hint bar along the bottom ("A Choose · B Back · D-pad Move"), from fork::page::hints.
    in property <string> hint-text: "";
    // The footer, left to right: left (Back), middle (Skip), extra (Close the wizard in a rerun), right
    // (the primary Next or Finish). An empty text hides the button.
    in property <string> left-text: "";
    in property <string> middle-text: "";
    in property <string> extra-text: "";
    in property <string> right-text: "";
    // Which button is drawn as the primary one: 0 left, 1 middle, 2 extra, 3 right, -1 none.
    in property <int> primary-slot: 3;
    in property <int> focus-left: -1;
    in property <int> focus-middle: -1;
    in property <int> focus-extra: -1;
    in property <int> focus-right: -1;
    // The focus number that is selected, and the option it belongs to (-1 when a button is selected).
    in property <int> selected-index: -1;
    in property <int> selected-option: -1;

    callback option-requested(int);
    callback tile-requested(int);
    callback input-edited(string);
    callback button-requested(int);
    callback nav-hovered(int);
    callback close-requested();
    // The title bar's X: leave the wizard (B and Escape go back one step instead).
    callback exit-requested();
    callback move-requested(int, int);
    callback activate-requested();
    forward-focus: key-handler;

    in property <length> item-font-px-physical: 14px;
    in property <length> title-font-px-physical: 13px;
    in property <length> row-height-physical: 48px;
    in property <length> title-bar-height-physical: 34px;

    property <length> border-px: Theme.border-width * 1px / Theme.scale-factor;
    property <length> item-font-px: item-font-px-physical / Theme.scale-factor;
    property <length> title-font-px: title-font-px-physical / Theme.scale-factor;
    property <length> bar-height: title-bar-height-physical / Theme.scale-factor;
    property <length> row-height: row-height-physical / Theme.scale-factor;
    property <length> gutter: (root.full ? 30px : 14px) / Theme.scale-factor;
    property <length> spacing: 8px / Theme.scale-factor;
    property <length> button-padding: 18px / Theme.scale-factor;
    // The Import ports cards read from further away: bigger text, taller choices, bigger covers.
    property <length> body-font: root.item-font-px * (root.large ? 1.25 : 1.0);
    property <length> option-height: root.large ? max(root.row-height * 1.6, root.height * 0.088) : root.row-height * 1.3;
    property <length> bar-thickness: root.item-font-px * 0.4;
    // The focus ring: thick enough to find at a glance on a 7 inch screen.
    property <length> ring: max(3px, 4px / Theme.scale-factor);
    property <length> hint-h: root.hint-text == "" ? 0px : root.item-font-px * 2.0;

    // A pointer that merely rests where a page opened must not take the highlight from the controller
    // or the keyboard. The first pointer event after the page opens only records where the pointer is;
    // the highlight follows the pointer once it really moves (a few pixels, or onto another item).
    property <bool> pointer-armed: false;
    property <int> seen-id: -2;
    property <length> seen-x: 0px;
    property <length> seen-y: 0px;
    function pointer-moved(id: int, x: length, y: length) {
        if (id < 0) {
            return;
        }
        if (!root.pointer-armed) {
            if (root.seen-id == -2) {
                root.seen-id = id;
                root.seen-x = x;
                root.seen-y = y;
                return;
            }
            if (id == root.seen-id && Math.abs(x - root.seen-x) + Math.abs(y - root.seen-y) < 4px) {
                return;
            }
            root.pointer-armed = true;
        }
        root.nav-hovered(id);
    }

    // A new page drawn in this same window (src/app/page_dialog.rs keeps one window from page to page): the body
    // starts at the top, a resting pointer has to really move again before it takes the highlight, and the
    // keyboard goes to the page, or to its text box when that is where the cursor starts.
    public function page-shown() {
        root.pointer-armed = false;
        root.seen-id = -2;
        body.content-y = 0px;
        // A cursor that starts further down (a remembered place) is brought into view, even when its number is the
        // same as on the page before (then "changed selected-option" does not fire).
        if (root.selected-option >= 0) {
            root.reveal(root.selected-option);
        }
        if (root.has-input && root.selected-index == root.input-focus) {
            text-in.focus();
        } else {
            key-handler.focus();
        }
    }

    // The text box takes the keyboard while it is the selected item, and gives it back to the page when not.
    changed selected-index => {
        if (root.has-input && root.selected-index == root.input-focus) {
            text-in.focus();
        } else {
            key-handler.focus();
        }
    }

    // Keep the focused option in view when the body scrolls.
    changed selected-option => {
        if (root.selected-option >= 0 && root.selected-option < root.options.length) {
            root.reveal(root.selected-option);
        }
    }
    function reveal(index: int) {
        // The options start below the paragraphs and the summary card.
        let top = opts-box.y + index * (root.option-height + root.spacing);
        let bottom = top + root.option-height;
        if (top + body.content-y < 0px) {
            body.content-y = -top;
        } else if (bottom + body.content-y > body.height) {
            body.content-y = body.height - bottom;
        }
    }

    key-handler := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close-requested();
                return accept;
            } else if (event.text == Key.UpArrow) {
                root.move-requested(0, -1);
                return accept;
            } else if (event.text == Key.DownArrow) {
                root.move-requested(0, 1);
                return accept;
            } else if (event.text == Key.LeftArrow) {
                root.move-requested(-1, 0);
                return accept;
            } else if (event.text == Key.RightArrow) {
                root.move-requested(1, 0);
                return accept;
            } else if (event.text == Key.Return) {
                root.activate-requested();
                return accept;
            }
            return reject;
        }

        chrome := DialogChrome {
            dialog-title: root.dialog-title;
            // Full screen: no title bar and no X (B and the hint bar say how to leave).
            bar-height: root.full ? 0px : root.bar-height;
            closable: !root.full;
            title-font-px: root.title-font-px;
            border-px: root.border-px;
            logical-w: root.width - root.border-px * 2;
            logical-h: root.height - root.border-px * 2;
            close-requested => { root.exit-requested(); }

            property <length> inner-w: chrome.content-width - root.gutter * 2;
            // Full screen drops the header line: the counter sits at the right of the title instead.
            property <length> header-h: root.full ? 0px : root.item-font-px * 1.7;
            property <string> corner-text: root.step-text != "" ? root.step-text : root.header-text;
            property <length> title-h: root.item-font-px * 2.2;
            property <length> footer-y: chrome.content-height - root.hint-h - root.gutter - root.row-height;
            property <length> body-y: root.gutter + self.header-h + root.bar-thickness + root.spacing * 2 + self.title-h;
            // Button widths (the text's own width plus padding), for placing the buttons that follow.
            property <length> left-w: root.left-text == "" ? 0px : left-m.preferred-width + root.button-padding * 2;
            property <length> middle-w: root.middle-text == "" ? 0px : middle-m.preferred-width + root.button-padding * 2;
            property <length> middle-x: root.gutter + self.left-w + (root.left-text == "" ? 0px : root.spacing);
            property <length> extra-x: self.middle-x + self.middle-w + (root.middle-text == "" ? 0px : root.spacing);

            if !root.full: Text {
                x: root.gutter;
                y: root.gutter;
                width: chrome.inner-w * 0.6;
                height: chrome.header-h;
                text: root.header-text;
                color: Theme.list-text;
                font-size: root.item-font-px;
                font-weight: 700;
                vertical-alignment: center;
                overflow: elide;
            }
            if !root.full: Text {
                x: root.gutter + chrome.inner-w * 0.6;
                y: root.gutter;
                width: chrome.inner-w * 0.4;
                height: chrome.header-h;
                text: root.step-text;
                color: Theme.search-text;
                font-size: root.item-font-px;
                horizontal-alignment: right;
                vertical-alignment: center;
            }

            // The progress bar: one segment per step, filled up to the current one.
            for n in root.step-count: Rectangle {
                property <length> gap: root.spacing * 0.6;
                property <length> seg-w: (chrome.inner-w - (root.step-count - 1) * self.gap) / root.step-count;
                x: root.gutter + n * (self.seg-w + self.gap);
                y: root.gutter + chrome.header-h + root.spacing * 0.5;
                width: self.seg-w;
                height: root.bar-thickness;
                border-radius: root.bar-thickness / 2;
                background: n <= root.step-index ? SemanticColors.info : Theme.border-color;
            }

            Text {
                x: root.gutter;
                y: root.gutter + chrome.header-h + root.bar-thickness + root.spacing * 1.5;
                width: root.full ? chrome.inner-w * 0.66 : chrome.inner-w;
                height: chrome.title-h;
                text: root.page-title;
                color: Theme.list-text;
                font-size: root.item-font-px * 1.5;
                font-weight: 700;
                vertical-alignment: center;
                overflow: elide;
            }
            if root.full: Text {
                x: root.gutter + chrome.inner-w * 0.66;
                y: root.gutter + chrome.header-h + root.bar-thickness + root.spacing * 1.5;
                width: chrome.inner-w * 0.34;
                height: chrome.title-h;
                text: chrome.corner-text;
                color: Theme.search-text;
                font-size: root.item-font-px;
                horizontal-alignment: right;
                vertical-alignment: center;
                overflow: elide;
            }

            // The body reaches into the right margin, where its scrollbar runs, so its content ends where the step bar
            // and the counter end.
            body := Flickable {
                x: root.gutter;
                y: chrome.body-y;
                width: chrome.inner-w + root.gutter;
                height: chrome.footer-y - root.gutter - chrome.body-y;
                content-width: self.width;
                content-height: max(self.height, body-layout.preferred-height);

                body-layout := VerticalLayout {
                    alignment: start;
                    x: 0px;
                    y: 0px;
                    width: body.width - root.gutter;
                    spacing: root.spacing;

                    for p in root.paragraphs: Text {
                        text: p;
                        color: Theme.list-text;
                        font-size: root.body-font;
                        wrap: word-wrap;
                    }
                    if root.facts.length > 0: Rectangle {
                        background: Theme.search-background;
                        border-width: root.border-px;
                        border-color: Theme.border-color;
                        height: facts-layout.preferred-height + root.gutter * 1.6;
                        facts-layout := VerticalLayout {
                            alignment: start;
                            x: root.gutter * 0.8;
                            y: root.gutter * 0.7;
                            width: parent.width - root.gutter * 1.6;
                            spacing: root.spacing * 0.5;
                            for f in root.facts: HorizontalLayout {
                                spacing: root.body-font * 0.5;
                                if f.mark > 0: VerticalLayout {
                                    alignment: start;
                                    padding-top: root.body-font * 0.12;
                                    StatusIcon {
                                        mark: f.mark;
                                        width: root.body-font * 1.1;
                                        height: root.body-font * 1.1;
                                    }
                                }
                                // A line without a mark on a page whose other lines have one keeps their indent.
                                if f.mark == 0 && root.facts-marked: Rectangle {
                                    width: root.body-font * 1.1;
                                }
                                Text {
                                    text: f.text;
                                    color: Theme.list-text;
                                    font-size: root.body-font;
                                    wrap: word-wrap;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                    }
                    if root.progress-kind > 0: ProgressBar {
                        height: root.body-font * 0.8;
                        busy: root.progress-kind == 2;
                        value: root.progress-value;
                    }
                    input-box := Rectangle {
                        height: root.has-input ? root.option-height : 0px;
                        visible: root.has-input;
                        background: Theme.search-background;
                        border-width: root.border-px;
                        border-color: Theme.border-color;
                        text-in := TextInput {
                            x: root.body-font * 0.8;
                            width: parent.width - root.body-font * 1.6;
                            height: parent.height;
                            vertical-alignment: center;
                            single-line: true;
                            font-size: root.body-font;
                            color: Theme.list-text;
                            text <=> root.input-text;
                            edited => { root.input-edited(self.text); }
                            changed has-focus => {
                                if (self.has-focus && root.selected-index != root.input-focus) {
                                    root.nav-hovered(root.input-focus);
                                }
                            }
                            key-pressed(event) => {
                                if (event.text == Key.Escape) {
                                    root.close-requested();
                                    accept
                                } else if (event.text == Key.UpArrow) {
                                    root.move-requested(0, -1);
                                    accept
                                } else if (event.text == Key.DownArrow) {
                                    root.move-requested(0, 1);
                                    accept
                                } else if (event.text == Key.Return) {
                                    // Like A on the box (it moves on to the choices), through the same one-press filter.
                                    root.activate-requested();
                                    accept
                                } else {
                                    reject
                                }
                            }
                        }
                        if root.has-input && root.selected-index == root.input-focus: FocusRing {
                            width: 100%;
                            height: 100%;
                            ring-px: root.ring;
                        }
                        if root.has-input && root.input-text == "": Text {
                            x: root.body-font * 0.8;
                            width: parent.width - root.body-font * 1.6;
                            height: parent.height;
                            text: root.input-placeholder;
                            color: Theme.search-text;
                            font-size: root.body-font;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    if root.has-card: CardBox {
                        // A QR code (a square card) gets the room to be scanned from across a room.
                        height: root.large ? root.height * (root.card.square ? 0.47 : 0.34) : root.row-height * 4.2;
                        card: root.card;
                        font-size: root.body-font;
                        border-px: root.border-px;
                    }
                    if root.tiles.length > 0: Rectangle {
                        // Three choices under the covers (Which port is this?) need the room: the covers are a little smaller.
                        property <length> cover-h: root.large ? root.height * (root.options.length >= 3 ? 0.16 : 0.2) : root.row-height * 3.4;
                        property <length> tile-w: self.cover-h * (root.large && root.options.length >= 3 ? 1.07 : 0.85);
                        property <length> tile-h: self.cover-h + root.body-font * 3.6;
                        property <float> per-row: max(1, Math.floor((body.width - root.gutter) / (self.tile-w + root.spacing)));
                        height: Math.ceil(root.tiles.length / self.per-row) * (self.tile-h + root.spacing);
                        for t[i] in root.tiles: TileBox {
                            x: Math.mod(i, parent.per-row) * (parent.tile-w + root.spacing);
                            y: Math.floor(i / parent.per-row) * (parent.tile-h + root.spacing);
                            width: parent.tile-w;
                            height: parent.tile-h;
                            tile: t;
                            selected: t.focus >= 0 && root.selected-index == t.focus;
                            font-size: root.body-font;
                            border-px: root.border-px;
                            ring-px: root.ring;
                            clicked => { root.tile-requested(i); }
                            moved(x, y) => { root.pointer-moved(t.focus, x, y); }
                        }
                    }
                    opts-box := VerticalLayout {
                        spacing: root.spacing;
                        for o[i] in root.options: OptionRow {
                            height: root.option-height;
                            title: o.title;
                            detail: o.detail;
                            kind: o.kind;
                            chosen: o.chosen;
                            enabled: o.enabled;
                            recommended: o.recommended;
                            icon: o.icon;
                            toggle: o.toggle;
                            selected: o.enabled && root.selected-index == o.focus;
                            border-px: root.border-px;
                            ring-px: root.ring;
                            font-size: root.body-font;
                            clicked => { root.option-requested(i); }
                            moved(x, y) => { root.pointer-moved(o.focus, x, y); }
                        }
                    }
                    if root.footnote != "": Text {
                        text: root.footnote;
                        color: Theme.search-text;
                        font-size: root.body-font * 0.9;
                        wrap: word-wrap;
                    }
                }
            }
            ThemedScrollbar {
                x: root.gutter + chrome.inner-w + (root.gutter - self.width) / 2;
                y: body.y;
                height: body.height;
                viewport-height: body.content-height;
                visible-height: body.height;
                viewport-y <=> body.content-y;
            }

            // Footer: Back on the left (Skip and the rerun's Close next to it), the primary button on the right.
            if root.left-text != "": WizardButton {
                x: root.gutter;
                y: chrome.footer-y;
                width: chrome.left-w;
                height: root.row-height;
                text: root.left-text;
                primary: root.primary-slot == 0;
                selected: root.selected-index == root.focus-left;
                border-px: root.border-px;
                ring-px: root.ring;
                font-size: root.item-font-px;
                clicked => { root.button-requested(0); }
                moved(x, y) => { root.pointer-moved(root.focus-left, x, y); }
            }
            if root.middle-text != "": WizardButton {
                x: chrome.middle-x;
                y: chrome.footer-y;
                width: chrome.middle-w;
                height: root.row-height;
                text: root.middle-text;
                primary: root.primary-slot == 1;
                selected: root.selected-index == root.focus-middle;
                border-px: root.border-px;
                ring-px: root.ring;
                font-size: root.item-font-px;
                clicked => { root.button-requested(1); }
                moved(x, y) => { root.pointer-moved(root.focus-middle, x, y); }
            }
            if root.extra-text != "": WizardButton {
                x: chrome.extra-x;
                y: chrome.footer-y;
                width: self.text-preferred-width + root.button-padding * 2;
                height: root.row-height;
                text: root.extra-text;
                primary: root.primary-slot == 2;
                selected: root.selected-index == root.focus-extra;
                border-px: root.border-px;
                ring-px: root.ring;
                font-size: root.item-font-px;
                clicked => { root.button-requested(2); }
                moved(x, y) => { root.pointer-moved(root.focus-extra, x, y); }
            }
            if root.right-text != "": WizardButton {
                x: chrome.content-width - root.gutter - self.width;
                y: chrome.footer-y;
                width: self.text-preferred-width + root.button-padding * 2;
                height: root.row-height;
                text: root.right-text;
                primary: root.primary-slot == 3;
                selected: root.selected-index == root.focus-right;
                border-px: root.border-px;
                ring-px: root.ring;
                font-size: root.item-font-px;
                clicked => { root.button-requested(3); }
                moved(x, y) => { root.pointer-moved(root.focus-right, x, y); }
            }
            // The controller hint bar: what A, B and the D-pad do on this page.
            if root.hint-text != "": Rectangle {
                x: 0px;
                y: chrome.content-height - root.hint-h;
                width: chrome.content-width;
                height: root.hint-h;
                background: Theme.search-background;
                Rectangle {
                    y: 0px;
                    height: root.border-px;
                    background: Theme.border-color;
                }
                Text {
                    x: root.gutter;
                    width: parent.width - root.gutter * 2;
                    height: parent.height;
                    text: root.hint-text;
                    color: Theme.list-text;
                    font-size: root.item-font-px * 0.95;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            // Measure the texts that position the buttons after them.
            left-m := Text {
                visible: false;
                text: root.left-text;
                font-size: root.item-font-px;
            }
            middle-m := Text {
                visible: false;
                text: root.middle-text;
                font-size: root.item-font-px;
            }
        }
    }
}
